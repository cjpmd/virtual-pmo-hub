# Self-service sign-up. Leave unset (or anything but "true") to send /signup to /request-access.
VITE_SELF_SIGNUP=false
# Board automations: hidden until work package 4.3 makes them run (decision D4).
VITE_BOARD_AUTOMATIONS=false
# Address that receives access and demo requests from /request-access.
VITE_CONTACT_EMAIL=

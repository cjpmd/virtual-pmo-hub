# Self-service organisation creation (open sign-up with a 14-day free trial). On unless set to
# "false", which is the kill switch: /signup/setup then sends people to /request-access.
# Creating an account (email + password or Microsoft) is always allowed.
VITE_SELF_SIGNUP=true
# Board automations: hidden until work package 4.3 makes them run (decision D4).
VITE_BOARD_AUTOMATIONS=false
# Address that receives access and demo requests from /request-access.
VITE_CONTACT_EMAIL=

# Auth (docs/auth-setup.md). Nothing secret belongs in this file or in any VITE_* variable:
# VITE_* values are built into the browser bundle. The Microsoft (Entra ID) client ID and
# client secret, and the SMTP password, are entered in the Supabase dashboard only.
# Supabase project URL and publishable (anon) key; the generated client also hardcodes them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Not used yet: add it with CAPTCHA protection later
# (components/auth/captcha.tsx). The Turnstile secret key goes in Supabase, never here.
# VITE_TURNSTILE_SITE_KEY=
